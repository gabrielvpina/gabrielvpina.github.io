<ul class="file-list"><% for (const item of items) { %><li class="file-entry"><a class="file-link" href="<%= item.path %>"><span class="file-date"><%= item.date %></span><span class="file-name"><%= item.title %></span><span class="file-arrow">&#8594;</span><% if (item.categories && item.categories.length) { %><span class="file-tags"><% for (const c of item.categories) { %><span class="tag"><%= c %></span><% } %></span><% } %></a></li><% } %></ul>